# CROSSUB Voice Agent — environment template.
# Copy to `.env` and fill in. `.env` is gitignored.

# --- LiveKit (LiveKit Cloud → Project → Settings → Keys) ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech-to-text: Deepgram (https://console.deepgram.com) ---
DEEPGRAM_API_KEY=

# --- Text-to-speech: ElevenLabs (https://elevenlabs.io) ---
ELEVENLABS_API_KEY=

# --- LLM: Anthropic Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- CROSSUB Nest API (voice action tools: verify tenant + create end-leasing) ---
# Base URL of the crossub_web Nest API the move-out tools POST to. Local smoke:
# http://localhost:3010 ; or the Render staging URL. Leave BLANK to run the agent
# without backend actions — the tools then degrade gracefully (the agent tells the
# caller a team member will follow up) instead of crashing.
# VOICE_API_BASE_URL=http://localhost:3010
# Shared machine-auth secret; sent as the `x-voice-service-token` header on every
# tool call and must match VOICE_SERVICE_TOKEN on the Nest side. Blank => tools
# degrade gracefully (no requests are sent).
# VOICE_SERVICE_TOKEN=

# --- Answer behaviour ---
# divert (default) = the tenant line: hear the enquiry, point the caller at the
#   email channel, take NO action. The agent is given no tools at all in this mode.
# full             = the earlier self-service assistant (verify the caller, read
#   their rent/lease/inspection data, lodge move-outs and repairs). Kept working
#   so the pivot is reversible; anything unrecognised falls back to divert.
VOICE_MODE=divert
# The intake address the agent reads out in divert mode. Must be a mailbox the
# support sweep actually polls — support@ already runs AI triage + auto-reply.
VOICE_INTAKE_EMAIL=support@crossub.com.au
# Optional SMS intake number, spoken as a second option. LEAVE BLANK: as of Aug 2026
# crossub_web has NO SMS provider (no Twilio, no sendSms), so a text sent here would
# reach nobody. Set it only after inbound SMS is delivered somewhere the team reads.
# VOICE_INTAKE_SMS_NUMBER=

# --- Optional model / voice overrides (defaults shown) ---
VOICE_STT_MODEL=nova-3
# STT language: "multi" attempts EN/中文 code-switching in one stream.
# If Chinese quality is poor, test a per-call language ("en" / "zh") instead — see README.
VOICE_STT_LANGUAGE=multi
VOICE_LLM_MODEL=claude-haiku-4-5
# The TTS model is switched PER TURN alongside the voice, because the two languages
# want opposite trade-offs. Measured Aug 2026 (time to first audio byte, 3 runs):
#   eleven_flash_v2_5       en 312ms   zh 317ms
#   eleven_multilingual_v2  en 1233ms  zh 1313ms   <- ~1s slower, better Mandarin
# So English uses flash (fast, accepts an enforced language code) and 中文 uses
# multilingual_v2 (better Mandarin). Setting multilingual_v2 for BOTH would add ~900ms
# to every English turn — most callers — and blow the <800ms conversational target.
VOICE_TTS_MODEL=eleven_flash_v2_5
VOICE_TTS_MODEL_ZH=eleven_multilingual_v2
# English / default voice id (blank = plugin default voice):
# VOICE_TTS_VOICE_ID=
# Dedicated Chinese (中文) voice id — the agent switches to it when the caller
# speaks Chinese, so Mandarin sounds native instead of the English voice reading it
# with an accent. Blank = reuse the English voice.
#
# ⚠️ This REQUIRES A PAID ELEVENLABS PLAN. A free-tier key is refused every Voice
# Library voice with 402 paid_plan_required (verified Aug 2026), so on a free key
# the only usable voices are the premade ones — all English-native speakers, which
# is exactly what makes the Mandarin sound accented. The multilingual model above
# softens it; a native voice is the actual fix. Candidate Beijing-Mandarin voices,
# once the plan allows them:
#   007rapvffUWW4JvRagws  Bo   — calm, conversational  (best fit for a phone line)
#   cIgfFHYNnHGsenWoEwaO  Zhan — steady, confident
# Or browse elevenlabs.io/app/voice-library → Language = Chinese → Add to my voices.
# VOICE_TTS_VOICE_ID_ZH=
VOICE_AGENT_NAME=crossub-inbound

# Enable LiveKit Cloud telephony noise cancellation (needs `uv sync --extra telephony`):
# VOICE_TELEPHONY_NOISE_CANCELLATION=true
